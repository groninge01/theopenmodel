# Server/build-time secrets only. Never rename a key to NEXT_PUBLIC_* and never
# commit real values. The fetch scripts read .env.local; without
# FOOTBALL_DATA_KEY the refresh exits without touching any data files.

# Portal snapshot — provider-neutral settings that apply whichever source wrote
# data/portal.json. The window is how far back finished results are collected
# and how far ahead fixtures are shown; widen the lookbehind to backfill results
# after an outage (e.g. PORTAL_LOOKBEHIND_DAYS=30). Absolute destination paths
# let a server timer update the active static site without a build.
PORTAL_LOOKBEHIND_DAYS=10
PORTAL_LOOKAHEAD_DAYS=14
PORTAL_DESTINATION=data/portal.json
PORTAL_PUBLIC_DESTINATION=public/data/portal-live.json

# Season the schedule covers; shared with scripts/fetch-fixtures.mjs.
FIXTURES_SEASON=2026

# Primary provider — register a free key at football-data.org. The free tier
# allows 10 requests/minute (MIN_INTERVAL_MS spaces calls to stay under it), and
# covers all five covered leagues plus a few more competitions.
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_TIMEOUT_MS=15000
FOOTBALL_DATA_RETRIES=2
FOOTBALL_DATA_FETCH_STANDINGS=true
FOOTBALL_DATA_MIN_INTERVAL_MS=6500
FOOTBALL_DATA_MIN_AGE_HOURS=20

# Legacy provider — dormant: the free plan no longer covers the current season.
# Kept so the path can resume if a paid key returns (npm run data:portal:apifb).
# REFRESH_MODE=full refreshes every UTC date in the lookahead then standings;
# live only merges today's fixtures plus the in-play endpoint into an existing
# full snapshot — run full once before scheduling live. LEAGUE_IDS empty keeps
# every league returned by the fixtures endpoints.
API_FOOTBALL_KEY=
API_FOOTBALL_REFRESH_MODE=full
API_FOOTBALL_TIMEOUT_MS=15000
API_FOOTBALL_RETRIES=2
API_FOOTBALL_FAIL_ON_ERROR=false
API_FOOTBALL_LEAGUE_IDS=
API_FOOTBALL_FETCH_LIVE=true
API_FOOTBALL_FETCH_STANDINGS=true
API_FOOTBALL_MAX_STANDING_TABLES=20

# Optional news output paths. A scheduled fetch can point the public destination
# at the active static site's data directory so headlines update without a build.
NEWS_DESTINATION=data/news.json
NEWS_PUBLIC_DESTINATION=public/data/news-live.json
NEWS_FAIL_ON_ERROR=false
